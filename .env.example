# ══════════════════════════════════════════════════════════════
# API IESTP — Variables de entorno (plantilla)
# Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas `.env` ni credenciales reales al repositorio.
# ══════════════════════════════════════════════════════════════

# ─── Entorno ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Servidor PHP (archivos: upload.php, imágenes, QR, horarios) ─
PHP_URL=https://www.iestpasist.com

# ─── Base de datos (MySQL/MariaDB) ──────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=aplicativo
DB_CONNECTION_LIMIT=10

# ─── CORS ───────────────────────────────────────────────────────
# Orígenes permitidos separados por coma (ej: http://localhost:8081,https://app.iestp.edu.pe)
CORS_ORIGIN=*

# ─── Seguridad ──────────────────────────────────────────────────
# Máximo de intentos de login por ventana de 15 minutos
LOGIN_RATE_LIMIT_MAX=100

# ─── Logging ────────────────────────────────────────────────────
# Niveles: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
