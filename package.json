{
  "name": "api-iestp",
  "version": "2.0.0",
  "description": "API REST del IESTP: estudiantes, notas, unidades didácticas, horarios, justificaciones, códigos QR e imágenes de perfil.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "health": "node -e \"fetch('http://localhost:3000/health').then(r => r.json()).then(j => console.log(JSON.stringify(j, null, 2)))\""
  },
  "keywords": [
    "iestp",
    "api",
    "express",
    "mysql",
    "estudiantes",
    "notas",
    "justificaciones"
  ],
  "author": "Progamins",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "form-data": "^4.0.1",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
